{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cognitum.one/cognitum.cog.release-trust.v2.schema.json",
  "title": "Cog release public-key trust registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "keys"],
  "properties": {
    "schema": {
      "const": "cognitum.cog.release-trust.v2"
    },
    "keys": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "algorithm",
          "kmsAlgorithm",
          "kmsKeyVersion",
          "protectionLevel",
          "publicKeyFingerprint",
          "publicKeyPem",
          "status",
          "purposes",
          "builderIdentities",
          "buildWorkflows",
          "github"
        ],
        "properties": {
          "algorithm": {
            "const": "ed25519"
          },
          "kmsAlgorithm": {
            "const": "EC_SIGN_ED25519"
          },
          "kmsKeyVersion": {
            "type": "string",
            "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/locations/[a-z0-9-]+/keyRings/[A-Za-z0-9_-]{1,63}/cryptoKeys/[A-Za-z0-9_-]{1,63}/cryptoKeyVersions/[1-9][0-9]*$"
          },
          "protectionLevel": {
            "const": "software"
          },
          "publicKeyFingerprint": {
            "$ref": "#/$defs/digest"
          },
          "publicKeyPem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "status": {
            "enum": ["active", "revoked"]
          },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": ["release", "withdrawal"]
            }
          },
          "builderIdentities": {
            "$ref": "#/$defs/boundedUniqueStrings"
          },
          "buildWorkflows": {
            "$ref": "#/$defs/boundedUniqueStrings"
          },
          "github": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ownerId", "repositoryId", "workflowIds"],
            "properties": {
              "ownerId": {
                "$ref": "#/$defs/numericGithubId"
              },
              "repositoryId": {
                "$ref": "#/$defs/numericGithubId"
              },
              "workflowIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/numericGithubId"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "boundedUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "numericGithubId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{4,24}$"
    }
  }
}
