# macOS
.DS_Store

# Rust
/target/
**/target/
# src/cogs/*/Cargo.lock was ignored here. Removed deliberately: every cog is a BINARY crate
# ([[bin]] in its Cargo.toml), and Cargo's own guidance is to commit lockfiles for binaries
# and omit them for libraries. Without a committed lock, `cargo build` re-resolves serde and
# friends on every run, so two builds of one commit can differ — and a signature over a build
# nobody can reproduce attests to an artifact that cannot be re-derived. The root Cargo.lock
# was already tracked; these are the same case.
**/*.rs.bk
*.pdb

# AQE / agentic test runner artifacts (per memory: never `git add dir/` with
# AQE hooks running — they drop .rvf files silently)
.agentic-qe/
**/.agentic-qe/

# Node
node_modules/

# IDE
.idea/
.vscode/
dist/

# Claude tooling
.claude-flow/
.mcp.json
*.db

# Build artifacts — cross-compiled cog binaries (published to GCS, not git).
# Covers -arm / -aarch64 outputs and local *-fix iteration builds.
cog-*-arm
cog-*-arm-fix*
cog-*-aarch64
out/

# Ephemeral credential files emitted by google-github-actions/auth.
gha-creds-*.json
